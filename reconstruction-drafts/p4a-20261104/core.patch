+        val payload=ProactiveReplyAcceptance.encode(value);assertEquals(value,ProactiveReplyAcceptance.decode(payload))
+        for(bad in listOf(payload.replaceFirst("{","{\"version\":1,"),payload.replaceFirst("{","{\"extra\":1,"),
