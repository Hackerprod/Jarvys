{
  "schemaVersion": 1,
  "id": "com.jarvys.module.chart",
  "version": "1.0.0",
  "name": "Gráficas",
  "artifactTypes": [
    {
      "type": "application/vnd.jarvys.chart+json",
      "viewer": "viewer/chart.html",
      "generatedThumbnail": true
    }
  ],
  "tools": [
    {
      "name": "create_chart",
      "description": "Crea una gráfica local con Chart.js y entrega un artefacto con miniatura PNG. Los errores de entrada corregibles indican qué cambiar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "description": "Título que se muestra en la gráfica y en su tarjeta." },
          "chartType": { "type": "string", "description": "Tipo admitido por Chart.js: bar, bubble, doughnut, line, pie, polarArea, radar o scatter." },
          "labels": { "type": "array", "items": { "type": "string" }, "description": "Etiquetas que corresponden a los valores de las series." },
          "datasets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "data": { "type": "array", "items": { "type": "number" } },
                "backgroundColor": { "anyOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ] },
                "borderColor": { "anyOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ] },
                "borderWidth": { "type": "number" },
                "fill": { "type": "boolean" }
              },
              "required": ["label", "data"],
              "additionalProperties": false
            },
            "description": "Una o más series con un valor por etiqueta."
          },
          "options": { "type": "object", "description": "Opciones adicionales de Chart.js en formato JSON." }
        },
        "required": ["title", "chartType", "labels", "datasets"],
        "additionalProperties": false
      },
      "access": "write",
      "handler": "logic/tools.js#createChart"
    }
  ],
  "skills": ["skills/chart/SKILL.md"],
  "capabilities": ["artifact.deliver"]
}
