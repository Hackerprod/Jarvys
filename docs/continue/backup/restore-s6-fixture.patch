+                com.jarvys.agent.workspaces.WorkspaceMutationTestSupport.create("deliver", source.getWorkspaceId(),
+                        new EffectInvocation(admission -> {}), () -> {});
+        service().deliver(source.getWorkspaceId(), "typed-report.txt", hash("first"), null,
+                CancellationToken.cancellable(), () -> {}, repeat);
+        EffectInvocation.Receipt duplicate = com.jarvys.agent.workspaces.WorkspaceMutationTestSupport.receipt(repeat);
+        assertEquals(EffectInvocation.Outcome.UNCERTAIN, duplicate.outcome);
+        assertEquals(EffectInvocation.CompletionSemantics.EXISTING_REFERENCE, duplicate.completionSemantics);
+        assertEquals(first.reference, duplicate.reference);
