+            }
+            val mutation = WorkspaceMutationContext("delegate", scope.workspaceId, null, invocation, noAdmission)
+            val result = coordinator.delegate(scope.workspaceId, "assignment", "custom", MISSION, emptyList(), "Synthetic worker",
