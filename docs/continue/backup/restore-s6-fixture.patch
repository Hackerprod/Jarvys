+        ArtifactOsShadow.beforeOpen = opened::incrementAndGet;
+        com.jarvys.agent.workspaces.WorkspaceMutationContext mutation =
+                com.jarvys.agent.workspaces.WorkspaceMutationTestSupport.create("deliver", source.getWorkspaceId(),
+                        new EffectInvocation(admission -> { throw new IllegalStateException("Evidence unavailable"); }), () -> {});
+        assertThrows(IllegalStateException.class, () -> service().deliver(source.getWorkspaceId(),
