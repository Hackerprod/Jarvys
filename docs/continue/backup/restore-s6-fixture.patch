+            "FILE", "typed/rollback.txt", "d".repeat(64))
+        database.testChatSql.execSQL("CREATE TRIGGER reject_typed_artifact BEFORE INSERT ON artifacts " +
+            "BEGIN SELECT RAISE(ABORT, 'synthetic artifact rejection'); END")
+        var failed = false
+        try { failed = artifacts.appendDeliveredArtifactWithReceipt(input) !is ChatDbResult.Success }
+        catch (_: Exception) { failed = true }
+        assertTrue(failed)
+        assertTrue(artifacts.artifactsForConversation("typed-rollback").isEmpty())
+        database.testChatSql.execSQL("DROP TRIGGER reject_typed_artifact")
+        val committed = success(artifacts.appendDeliveredArtifactWithReceipt(input))
+        assertTrue(committed.inserted)
+        assertFalse(success(artifacts.appendDeliveredArtifactWithReceipt(input)).inserted)
+    }
+
