+        // Rebuild an exact v1-shaped fixture from the existing schema, excluding only the seven additive columns.
+        val schemas = mutableListOf<String>()
+        val inserts = mutableListOf<Pair<String, Array<Any?>>>()
+        val sourceColumns = setOf("source_generation", "source_owner", "source_message", "source_batch", "source_call", "source_run", "source_process")
+        SQLiteDatabase.openDatabase(path, null, SQLiteDatabase.OPEN_READWRITE).use { db ->
+            db.rawQuery("SELECT name,sql FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' AND name!='android_metadata' ORDER BY rowid", null).use { tables ->
+                while (tables.moveToNext()) {
+                    val table = tables.getString(0)
+                    var sql = tables.getString(1)
+                    sourceColumns.forEach { sql = sql.replace(Regex(",\\s*" + it + " TEXT", RegexOption.IGNORE_CASE), "") }
+                    schemas += sql
+                    db.rawQuery("SELECT * FROM $table", null).use { rows ->
+                        val columns = rows.columnNames.filterNot { it in sourceColumns }
+                        while (rows.moveToNext()) {
+                            val values = columns.map<String, Any?> { column -> val index = rows.getColumnIndexOrThrow(column)
+                                when (rows.getType(index)) {
+                                    android.database.Cursor.FIELD_TYPE_NULL -> null
+                                    android.database.Cursor.FIELD_TYPE_INTEGER -> rows.getLong(index)
+                                    else -> rows.getString(index)
+                                }
+                            }.toTypedArray()
+                            inserts.add("INSERT INTO $table (${columns.joinToString(",")}) VALUES (${columns.joinToString(",") { "?" }})" to values)
+                        }
+                    }
+                }
+            }
+        }
+        context.deleteDatabase(WorkspaceRegistry.DATABASE_NAME)
+        SQLiteDatabase.openOrCreateDatabase(path, null).use { db ->
