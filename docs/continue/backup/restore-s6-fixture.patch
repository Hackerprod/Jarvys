+            override fun declaration() = ToolSpec("mixed_tool", "test", "Mixed", "test",
+                ToolSpec.Status.IMPLEMENTED, emptyMap(), emptyList())
+            override fun unattendedAccess() = com.jarvys.agent.CoreTool.UnattendedAccess.READ
+            override fun effectClass(arguments: Map<String, Any>) =
+                if (arguments["write"] == true) com.jarvys.agent.CoreTool.EffectClass.WRITE
+                else com.jarvys.agent.CoreTool.EffectClass.READ
+            override fun execute(arguments: Map<String, Any>, token: CancellationToken): CoreToolResult {
+                effects++
+                return CoreToolResult.success("legacy result without completion proof")
+            }
+        }
+        val wrapper = ScheduledTaskProcessor.TaskTrackedTool(delegate, false, calls, false,
+            sourceMessageId = "mixed-tool-source", episodeRunId = "mixed-tool-run", context = context)
+        wrapper.execute(mapOf("write" to true), CancellationToken.cancellable(), null,
+            com.jarvys.agent.EffectInvocation { })
+        assertEquals(1, effects)
+        assertTrue(calls.single().write)
+        assertEquals("UNKNOWN", calls.single().outcome)
+        assertTrue(calls.single().mayHaveWritten())
+    }
+
+    private fun contextAwareExecutor(block: (Context, ScheduledTask, TaskPendingAction,
+                                             com.jarvys.agent.EffectInvocation) -> com.jarvys.agent.CoreToolResult) =
