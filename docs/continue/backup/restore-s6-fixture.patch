+    /** Observation only: all declarations, policies and execute4/context behavior delegate unchanged. */
+    private static CoreToolRegistry observeResults(CoreToolRegistry registry,String name,
+            java.util.function.BiConsumer<Map<String,Object>,CoreToolResult> observe) {
+        List<CoreTool> handlers = registry.handlers();
+        for (int index=0;index<handlers.size();index++) {
+            CoreTool original = handlers.get(index);
+            if (!name.equals(original.declaration().name)) continue;
+            CoreTool wrapper = (CoreTool) java.lang.reflect.Proxy.newProxyInstance(CoreTool.class.getClassLoader(),
+                    new Class<?>[]{CoreTool.class},(proxy,method,arguments) -> {
+                        if (method.getDeclaringClass()==Object.class) {
+                            if ("equals".equals(method.getName())) return proxy==arguments[0];
+                            if ("hashCode".equals(method.getName())) return System.identityHashCode(proxy);
+                            return "Observed tool " + name;
+                        }
+                        try {
+                            Object returned = method.invoke(original,arguments);
+                            if ("execute".equals(method.getName()) && method.getParameterCount()==4) {
+                                assertNotNull(((EffectInvocation)arguments[3]).crewSource());
+                                @SuppressWarnings("unchecked") Map<String,Object> actual = (Map<String,Object>)arguments[0];
+                                observe.accept(actual,(CoreToolResult)returned);
+                            }
+                            return returned;
+                        } catch (java.lang.reflect.InvocationTargetException failure) { throw failure.getCause(); }
+                    });
+            handlers.set(index,wrapper);
+        }
+        return registry.replaceSelectedHandlers(handlers);
+    }
