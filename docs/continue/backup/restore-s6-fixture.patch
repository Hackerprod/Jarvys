+            override fun execute(context: Context, task: ScheduledTask, action: TaskPendingAction): com.jarvys.agent.CoreToolResult =
+                error("Explicit invocation context required")
+            override fun execute(context: Context, task: ScheduledTask, action: TaskPendingAction,
+                                 invocation: com.jarvys.agent.EffectInvocation) = block(context, task, action, invocation)
+            override fun hasCompleteEffectAdmissionCoverage() = true
+        }
